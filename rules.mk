# Build Options
BOOTMAGIC_ENABLE = yes
EXTRAKEY_ENABLE  = yes
MOUSEKEY_ENABLE  = yes
CONSOLE_ENABLE   = yes
ENCODER_ENABLE   = yes
# Trackball
POINTING_DEVICE_ENABLE = yes
POINTING_DEVICE_DRIVER = pmw3389

# Disable keymap introspection to avoid unknown keycode errors
KEYMAP_INTROSPECTION_ENABLE = no
